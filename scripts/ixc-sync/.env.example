# Copy to .env for standalone runs/calibration (php artisan ixc:sync passes
# these as process env vars instead, so this file is NOT required in
# production — see scripts/ixc-sync/README.md).

IXC_BASE_URL=https://sistema.fenixwireless.com.br
IXC_USERNAME=
IXC_PASSWORD=

# Exact text as shown in the "Filiais" picker (see the screenshot you sent).
IXC_BRANCH_NAME=FENIX LITORAL-

# Comma-separated, exact text as shown in the "Colaborador" filter.
IXC_TECHNICIANS=GUSTAVO BEZZA (LITORAL),CEZAR GUEDES (LITORAL)

# 1 = save a screenshot + every captured network response into ./debug on
# every run. Turn this on for the first calibration runs, off once stable.
IXC_DEBUG=1
